{
  "name": "@robinhood-game/scroll-aws",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration:dynamodb": "vitest run --config vitest.integration.config.ts integration/dynamodb.integration.test.ts",
    "test:e2e:testnet": "vitest run --config vitest.integration.config.ts e2e/robinhood-testnet.readonly.test.ts",
    "test:watch": "vitest",
    "synth": "cdk synth -o infra/cdk.out --app 'tsx infra/bin/app.ts'"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1127.0",
    "@aws-sdk/client-s3": "3.1127.0",
    "@aws-sdk/client-secrets-manager": "3.1127.0",
    "@aws-sdk/client-sqs": "3.1127.0",
    "@aws-sdk/lib-dynamodb": "3.1127.0",
    "@robinhood-game/scroll-state-core": "file:./state-core",
    "aws-cdk-lib": "2.268.0",
    "constructs": "10.8.1",
    "ethers": "6.17.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.163",
    "@types/node": "22.20.1",
    "aws-cdk": "2.1140.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
